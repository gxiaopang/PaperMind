# Copy this to the project root as .env; never commit real credentials.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+asyncpg://papermind:replace-with-a-random-password@localhost:15432/papermind
REDIS_URL=redis://localhost:16379/0
MAIL_ENCRYPTION_KEY=replace-with-a-fernet-key
MAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=papermind@example.com
# Optional root .env.smtp.local overrides SMTP credentials; SMTP_FROM aliases MAIL_FROM.
MAIL_FROM_NAME=PaperMind
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_S=90
LLM_FAST_BASE_URL=https://api.siliconflow.cn/v1
LLM_FAST_API_KEY=replace-me
LLM_FAST_MODEL=Qwen/Qwen3.8-27B
LLM_FAST_TIMEOUT_S=180
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=replace-me
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_S=20
RETRIEVAL_TOP_K=40
RERANK_TOP_N=8
RRF_K=60
# Positive relative weights; 1:1 preserves the original equal-weight RRF.
RRF_VECTOR_WEIGHT=1
RRF_BM25_WEIGHT=1
RRF_METADATA_WEIGHT=0.8
RERANK_SCORE_THRESHOLD=0.1
RETRIEVAL_MAX_SUBQUERIES=3
RETRIEVAL_MERGE_MIN_HITS=2
RETRIEVAL_CROSS_REF_MAX_CHUNKS=32
RETRIEVAL_BACKGROUND_WEIGHT=0.4
RETRIEVAL_TABLE_WEIGHT=1.5
RETRIEVAL_EXPERIMENT_WEIGHT=1.3
RETRIEVAL_QUERY_BYTES=1024
RERANK_CANDIDATE_BYTES=64000
RETRIEVAL_CONTEXT_BYTES=12000
RETRIEVAL_PARENT_BYTES=6000
RETRIEVAL_MAX_SOURCES=24
RETRIEVAL_PARENT_MAX_CHUNKS=32
RETRIEVAL_NEIGHBOR_WINDOW=1
# Direct section / element reads and combined tool responses are atomic under this byte cap.
PAPER_TOOL_MAX_BYTES=256000
# Chat graph limits also apply after a worker restart.
RAG_MODE=agentic
RAG_MAX_RETRIEVAL_RETRIES=2
RAG_MAX_GENERATION_RETRIES=1
MEMORY_RECENT_TOKEN_BUDGET=2000
MEMORY_SUMMARIZE_AFTER_TURNS=8
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_INITIAL_TOKEN_RESERVE=2048
CHAT_EVENT_TTL_S=86400
CHAT_MAX_RECOVERIES=3
CHECKPOINT_POOL_SIZE=4
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_API_TOKEN=replace-me
MINERU_MODEL_VERSION=vlm
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch
MINERU_POLL_TIMEOUT_S=900
MINERU_POLL_INTERVAL_S=3
MINERU_REQUEST_TIMEOUT_S=60
MINERU_HTTP_ATTEMPTS=3
# JSON arrays of exact HTTPS hosts; redirects are refused.
MINERU_UPLOAD_HOSTS=["mineru.oss-cn-shanghai.aliyuncs.com"]
MINERU_DOWNLOAD_HOSTS=["cdn-mineru.openxlab.org.cn"]
MINERU_MAX_ARCHIVE_MB=256
MINERU_MAX_EXPANDED_MB=1024
MINERU_MAX_ARCHIVE_ENTRIES=10000
MAX_UPLOAD_MB=100
MAX_UPLOAD_PAGES=200
TRACING_ENABLED=true
TRACE_CONTENT_ENABLED=false
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
USER_MAX_PAPERS=100
USER_MAX_STORAGE_MB=1024
USER_DAILY_PARSE_PAGES=200
USER_DAILY_MODEL_TOKENS=100000
USER_UPLOAD_CONCURRENCY=2
USER_CHAT_CONCURRENCY=2
PROVIDER_CONCURRENCY=8
GLOBAL_DAILY_MODEL_TOKENS=1000000
GLOBAL_DAILY_PARSE_PAGES=2000
EMBEDDING_BATCH_SIZE=16
INGESTION_MAX_ATTEMPTS=3
# Local development only; Compose overrides this with /app/data.
STORAGE_ROOT=../data
